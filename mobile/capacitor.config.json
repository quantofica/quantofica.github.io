{
  "appId": "pt.com.quantofica.app",
  "appName": "QuantoFica",
  "webDir": "www",
  "backgroundColor": "#f3f5f8",
  "ios": {
    "contentInset": "never",
    "scheme": "QuantoFica",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#1a4787",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DEFAULT"
    }
  }
}
